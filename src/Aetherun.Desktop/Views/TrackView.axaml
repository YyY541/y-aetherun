<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aetherun.Desktop.ViewModels"
             xmlns:controls="using:Aetherun.Desktop.Controls"
             x:Class="Aetherun.Desktop.Views.TrackView"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="*,396">

    <!-- ================= 3D 操场 ================= -->
    <Border Grid.Column="0" Classes="card">
      <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="20,16,20,0">
          <Border Grid.Column="0" Classes="mark" Margin="0,0,9,0" />
          <StackPanel Grid.Column="1" Spacing="1">
            <TextBlock Classes="sectionhead" Text="操场视图" />
            <TextBlock Classes="eyebrow" Text="3D PERSPECTIVE · 奶蛙沿跑道推进" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Border Classes="pill" Padding="11,4">
              <TextBlock Classes="mono" FontSize="10">
                <Run Text="{Binding Track.Perimeter, StringFormat='{}{0:F1}'}"
                     Foreground="{StaticResource AccentBrush}" /><Run Text=" m/圈"
                     Foreground="{StaticResource TextDimBrush}" />
              </TextBlock>
            </Border>
            <Border Classes="pill" Padding="11,4">
              <TextBlock Classes="mono" FontSize="10" Text="{Binding LapText}"
                         Foreground="{StaticResource AccentAltBrush}" />
            </Border>
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="18,14,18,0" CornerRadius="12" ClipToBounds="True"
                Background="#080C11" BorderBrush="{StaticResource LineSoftBrush}"
                BorderThickness="1">
          <controls:TrackScene3D Track="{Binding Track}"
                                 DistanceMeters="{Binding Snapshot.DistanceMeters}"
                                 TargetMeters="{Binding Snapshot.TargetMeters}"
                                 Running="{Binding IsRunning}"
                                 Cadence="{Binding Snapshot.Cadence}"
                                 CheckpointCount="5" />
        </Border>

        <!-- 图例 -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" Margin="20,12,20,16">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
            <Border Width="7" Height="7" CornerRadius="99" VerticalAlignment="Center"
                    Background="{StaticResource AccentBrush}" />
            <TextBlock Classes="caption" Text="奶蛙位置" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="18,0,0,0">
            <Border Width="7" Height="7" CornerRadius="99" VerticalAlignment="Center"
                    Background="{StaticResource AccentAltBrush}" />
            <TextBlock Classes="caption" Text="已跑轨迹" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="18,0,0,0">
            <Border Width="7" Height="7" CornerRadius="99" VerticalAlignment="Center"
                    Background="{StaticResource AccentWarmBrush}" />
            <TextBlock Classes="caption" Text="打卡点" />
          </StackPanel>
          <TextBlock Grid.Column="3" Classes="faint" FontSize="10" HorizontalAlignment="Right"
                     VerticalAlignment="Center" Text="只读预览 · 轨迹在「设置」里换" />
        </Grid>
      </Grid>
    </Border>

    <!-- ================= 奶蛙奔跑预览 ================= -->
    <Border Grid.Column="1" Classes="card" Margin="16,0,0,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,16">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
          <Border Grid.Column="0" Classes="mark" Margin="0,0,9,0"
                  Background="{StaticResource AccentWarmBrush}" />
          <StackPanel Grid.Column="1" Spacing="1">
            <TextBlock Classes="sectionhead" Text="奶蛙建模" />
            <TextBlock Classes="eyebrow" Text="NAIWA · 实时建模 · 可左右拖动" />
          </StackPanel>
          <Border Grid.Column="2" Classes="pill" Padding="9,3" VerticalAlignment="Center">
            <TextBlock Classes="mono" FontSize="9" Text="{Binding CadencePreviewText}"
                       Foreground="{StaticResource AccentWarmBrush}" />
          </Border>
        </Grid>

        <Border Grid.Row="1" CornerRadius="12" ClipToBounds="True"
                BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1">
          <controls:FrogPreview x:Name="Frog" Cadence="{Binding DashCadence}" />
        </Border>

        <!-- 视角控制 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,13,0,0">
          <StackPanel Grid.Column="0" Spacing="5">
            <TextBlock Classes="caption" Text="左右拖动画面或滑块转视角 · 0° 正面 / 180° 背面" />
            <Slider x:Name="YawSlider" Minimum="0" Maximum="360" Value="0" Height="22" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Bottom" Margin="14,0,0,2">
            <Button Classes="chip" Content="正面" Tag="0" Click="OnFace" />
            <Button Classes="chip" Content="侧面" Tag="90" Click="OnFace" />
            <Button Classes="chip" Content="背面" Tag="180" Click="OnFace" />
            <Button Classes="chip" Content="复位" Tag="auto" Click="OnAuto" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
